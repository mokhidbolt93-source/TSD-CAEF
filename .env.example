# ══════════════════════════════════════════════
# NECTA Monitor — Variables d'environnement
# Copiez ce fichier en .env et remplissez-le
# ══════════════════════════════════════════════

# Supabase — récupérez ces valeurs sur app.supabase.com
# Settings → API
SUPABASE_URL=https://VOTRE_ID.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT — chaîne aléatoire LONGUE et SECRÈTE (min 32 caractères)
# Générez avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=remplacez_par_une_chaine_aleatoire_longue_et_secrete

# Port du serveur (Railway le définit automatiquement)
PORT=3000
